# Copied from metadata-swiss/mds-datamodel ontology/dataelement/mdr-shapes.ttl (c815874); edit it there, then copy.
@prefix mdr:     <https://register.ld.admin.ch/mds/ontology/metadataregistry/> .
@prefix mdrsh:   <https://register.ld.admin.ch/mds/ontology/metadataregistry/shapes/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix adms:    <http://www.w3.org/ns/adms#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix prof:    <http://www.w3.org/ns/dx/prof/> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix vcard:   <http://www.w3.org/2006/vcard/ns#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix status:  <http://purl.org/adms/status/> .

# =====================================================================
# Metadata Registry (MDR) application profile
# Validates registry content: relationships, cardinalities, value types.
# Targets list every class explicitly, so validation does not depend on
# rdfs:subClassOf inference from the vocabulary.
# =====================================================================

mdrsh:
    a owl:Ontology ;
    dcterms:title "Metadata Registry shapes"@en ;
    dcterms:description "This ontology combines the Metadata Registry (MDR) vocabulary with SHACL shapes validating the content of the metadata registry."@en ;
    dcterms:created "2026-11-06"^^xsd:date ;
    dcterms:modified "2026-11-10"^^xsd:date ;
    owl:versionInfo "0.2.0" ;
    dcterms:publisher [
        a foaf:Organization ;
        foaf:name "Federal Statistical Office"@en , "Bundesamt für Statistik"@de ,
            "Office fédéral de la statistique"@fr , "Ufficio federale di statistica"@it ;
        foaf:homepage <https://www.bfs.admin.ch>
    ] ;
    dcat:contactPoint [
        a vcard:Individual ;
        vcard:fn "Peter Hutzli"
    ] ;
    rdfs:member
        mdrsh:AdministeredItemShape ,
        mdrsh:DataElementShape ,
        mdrsh:DataElementConceptShape ,
        mdrsh:ObjectClassShape ,
        mdrsh:PropertyItemShape ,
        mdrsh:ValueDomainShape ,
        mdrsh:ResourceDescriptorShape ;
    owl:imports <https://register.ld.admin.ch/mds/ontology/metadataregistry/> .

# ---------------------------------------------------------------------
# Administered item (applies to all registered items)
# ---------------------------------------------------------------------

mdrsh:AdministeredItemShape
    a sh:NodeShape ;
    rdfs:label "Administered item"@en ;
    sh:targetClass mdr:AdministeredItem, mdr:DataElement, mdr:DataElementConcept,
                   mdr:ObjectClass, mdr:Property, mdr:ValueDomain ;
    sh:nodeKind sh:IRI ;
    sh:property
        [ sh:path dcterms:identifier ; sh:name "identifier"@en ;
          sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
        [ sh:path dcterms:title ; sh:name "title"@en ;
          sh:minCount 1 ; sh:datatype rdf:langString ; sh:uniqueLang true ] ,
        [ sh:path dcterms:description ; sh:name "description"@en ;
          sh:datatype rdf:langString ; sh:uniqueLang true ] ,
        [ sh:path dcterms:created ; sh:name "created"@en ;
          sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ,
        [ sh:path dcterms:modified ; sh:name "modified"@en ;
          sh:maxCount 1 ; sh:datatype xsd:date ] ,
        [ sh:path dcterms:creator ; sh:name "creator"@en ;
          sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
        [ sh:path dcterms:publisher ; sh:name "publisher"@en ;
          sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
        [ sh:path adms:status ; sh:name "status"@en ;
          sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
        [ sh:path dcat:version ; sh:name "version"@en ;
          sh:maxCount 1 ; sh:datatype xsd:string ] ,
        [ sh:path prov:wasGeneratedBy ; sh:name "generated by"@en ;
          sh:description "The run that created an entry automatically."@en ;
          sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
        [ sh:path prov:wasDerivedFrom ; sh:name "derived from"@en ;
          sh:description "What an automatically created entry was made for, e.g. the slot it was first found for."@en ;
          sh:nodeKind sh:IRI ] ;
    # an entry under development (a candidate) names its creator or the run that created it
    sh:or (
        [ sh:not [ sh:property [ sh:path adms:status ; sh:hasValue status:UnderDevelopment ] ] ]
        [ sh:property [ sh:path dcterms:creator ; sh:minCount 1 ] ]
        [ sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ] ]
    ) .

# ---------------------------------------------------------------------
# Data element = data element concept + value domain
# ---------------------------------------------------------------------

mdrsh:DataElementShape
    a sh:NodeShape ;
    rdfs:label "Data element"@en ;
    sh:targetClass mdr:DataElement ;
    sh:property
        [ sh:path mdr:dataElementConcept ; sh:name "data element concept"@en ;
          sh:minCount 1 ; sh:maxCount 1 ; sh:class mdr:DataElementConcept ] ,
        [ sh:path mdr:valueDomain ; sh:name "value domain"@en ;
          sh:minCount 1 ; sh:maxCount 1 ; sh:class mdr:ValueDomain ;
          sh:equals sh:node ] ,
        [ sh:path sh:path ; sh:name "path"@en ;
          sh:description "The ontology property (e.g. schema:birthDate), not the mdr:Property wrapper."@en ;
          sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
        [ sh:path sh:node ; sh:name "node"@en ;
          sh:minCount 1 ; sh:maxCount 1 ; sh:class mdr:ValueDomain ] ,
        [ sh:path [ sh:alternativePath ( skos:closeMatch skos:broadMatch ) ] ;
          sh:name "I14Y match"@en ;
          sh:description "Informative link to an I14Y concept."@en ;
          sh:nodeKind sh:IRI ] ,
        # cardinality belongs to the slot in a data structure
        [ sh:path sh:minCount ; sh:maxCount 0 ;
          sh:message "Cardinality is set on the slot, not on the data element."@en ] ,
        [ sh:path sh:maxCount ; sh:maxCount 0 ;
          sh:message "Cardinality is set on the slot, not on the data element."@en ] ,
        # conformance to a standard is stated on the value domain only
        [ sh:path dcterms:conformsTo ; sh:maxCount 0 ;
          sh:message "dcterms:conformsTo is stated on the value domain."@en ] .

# ---------------------------------------------------------------------
# Semantic representation
# ---------------------------------------------------------------------

mdrsh:DataElementConceptShape
    a sh:NodeShape ;
    rdfs:label "Data element concept"@en ;
    sh:targetClass mdr:DataElementConcept ;
    sh:property
        [ sh:path mdr:objectClass ; sh:name "object class"@en ;
          sh:minCount 1 ; sh:maxCount 1 ; sh:class mdr:ObjectClass ] ,
        [ sh:path mdr:property ; sh:name "property"@en ;
          sh:minCount 1 ; sh:maxCount 1 ; sh:class mdr:Property ] ,
        [ sh:path [ sh:alternativePath ( skos:closeMatch skos:broadMatch ) ] ;
          sh:name "I14Y match"@en ;
          sh:description "Informative link to an I14Y concept."@en ;
          sh:nodeKind sh:IRI ] ,
        [ sh:path dcterms:conformsTo ; sh:maxCount 0 ;
          sh:message "dcterms:conformsTo is stated on the value domain."@en ] .

mdrsh:ObjectClassShape
    a sh:NodeShape ;
    rdfs:label "Object class"@en ;
    sh:targetClass mdr:ObjectClass ;
    sh:property
        [ sh:path skos:closeMatch ; sh:name "ontology class"@en ;
          sh:description "One or more ontology classes, e.g. schema:Person, foaf:Person."@en ;
          sh:nodeKind sh:IRI ] ;
    # required once the entry is accepted; a candidate created from the data may lack it
    sh:or (
        [ sh:property [ sh:path skos:closeMatch ; sh:minCount 1 ] ]
        [ sh:property [ sh:path adms:status ; sh:hasValue status:UnderDevelopment ] ]
    ) .

mdrsh:PropertyItemShape
    a sh:NodeShape ;
    rdfs:label "Property"@en ;
    sh:targetClass mdr:Property ;
    sh:property
        [ sh:path skos:closeMatch ; sh:name "ontology property"@en ;
          sh:description "One or more ontology properties, e.g. schema:birthDate."@en ;
          sh:nodeKind sh:IRI ] ;
    # required once the entry is accepted; a candidate created from the data may lack it
    sh:or (
        [ sh:property [ sh:path skos:closeMatch ; sh:minCount 1 ] ]
        [ sh:property [ sh:path adms:status ; sh:hasValue status:UnderDevelopment ] ]
    ) .

# ---------------------------------------------------------------------
# Technical representation
# ---------------------------------------------------------------------

mdrsh:ValueDomainShape
    a sh:NodeShape ;
    rdfs:label "Value domain"@en ;
    sh:targetClass mdr:ValueDomain ;
    # a value domain constrains literals (sh:datatype) or IRIs (sh:nodeKind)
    sh:or (
        [ sh:path sh:datatype ; sh:minCount 1 ]
        [ sh:path sh:nodeKind ; sh:minCount 1 ]
    ) ;
    sh:property
        [ sh:path sh:datatype ; sh:name "datatype"@en ;
          sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
        [ sh:path sh:nodeKind ; sh:name "node kind"@en ;
          sh:maxCount 1 ; sh:in ( sh:IRI sh:Literal ) ] ,
        [ sh:path dcterms:isVersionOf ; sh:name "version of"@en ;
          sh:description "The unversioned value domain this one is a version of, e.g. a code list version under its list."@en ;
          sh:maxCount 1 ; sh:class mdr:ValueDomain ] ,
        [ sh:path mdr:permissibleValues ; sh:name "permissible values"@en ;
          sh:maxCount 1 ;
          sh:or ( [ sh:class skos:ConceptScheme ] [ sh:class skos:Collection ] ) ] ,
        [ sh:path mdr:serialization ; sh:name "serialization"@en ;
          sh:class prof:ResourceDescriptor ; sh:node mdrsh:ResourceDescriptorShape ] ,
        [ sh:path dcterms:conformsTo ; sh:name "conforms to"@en ;
          sh:description "Standard defining this technical representation, e.g. an eCH standard."@en ;
          sh:nodeKind sh:IRI ] ,
        [ sh:path qudt:hasUnit ; sh:name "unit"@en ;
          sh:maxCount 1 ; sh:nodeKind sh:IRI ;
          sh:pattern "^http://qudt\\.org/vocab/unit/" ] ,
        [ sh:path qudt:hasQuantityKind ; sh:name "quantity kind"@en ;
          sh:maxCount 1 ; sh:nodeKind sh:IRI ;
          sh:pattern "^http://qudt\\.org/vocab/quantitykind/" ] ,
        [ sh:path [ sh:alternativePath ( skos:closeMatch skos:broadMatch ) ] ;
          sh:name "I14Y match"@en ;
          sh:description "Informative link to an I14Y concept."@en ;
          sh:nodeKind sh:IRI ] ,
        # a value domain is a reusable node shape: no path, no targets
        [ sh:path sh:path ; sh:maxCount 0 ] ,
        [ sh:path sh:targetClass ; sh:maxCount 0 ] ,
        [ sh:path sh:targetNode ; sh:maxCount 0 ] ,
        [ sh:path sh:targetSubjectsOf ; sh:maxCount 0 ] ,
        [ sh:path sh:targetObjectsOf ; sh:maxCount 0 ] .

mdrsh:ResourceDescriptorShape
    a sh:NodeShape ;
    rdfs:label "Resource descriptor"@en ;
    sh:property
        [ sh:path prof:hasArtifact ; sh:name "artifact"@en ;
          sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
        [ sh:path dcterms:conformsTo ; sh:name "conforms to"@en ;
          sh:description "Schema language, e.g. XML Schema or JSON Schema."@en ;
          sh:minCount 1 ; sh:nodeKind sh:IRI ] ,
        [ sh:path dcterms:format ; sh:name "format"@en ;
          sh:maxCount 1 ; sh:nodeKind sh:IRI ] .
