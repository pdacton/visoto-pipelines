NAME=concept-matching
GRAPH=urn:data:concept-matching-githubpipeline
LABEL="Links of auto-profiled slots to the metadata registry (visoto-pipelines)"
# Graph of a person's matches (confirmations.csv); never replaced by a pipeline run. Name still open.
CONFIRMATIONS_GRAPH=urn:data:concept-matching-confirmations
# Registry entries, runs and created concepts sit under this
BASE_IRI=${BASE_IRI:-https://register.ld.admin.ch/mds/}
# Input: out/slots.jsonl of the auto-profiling pipeline
SLOTS=${SLOTS:-../auto-profiling/out/slots.jsonl}
# LINDAS: the I14Y code lists (wrapped, codes kept in cache/codes.duckdb for matching)
LINDAS_ENDPOINT=https://ld.admin.ch/query
I14Y_GRAPH=https://lindas.admin.ch/fso/i14y
# Automatic code-list link: containment, distinct values and lead over the next list.
# Set 2026-11-11 from `python -m cmatch tune` on the draft gold set (precision 1.00, recall 0.62).
CODE_MIN_CONTAINMENT=0.98
CODE_MIN_DISTINCT=6
CODE_MIN_LEAD=0.1
# Lowest containment kept as a candidate; candidates kept per slot
CODE_CANDIDATE_MIN=0.5
CANDIDATES=3
# Identifier validators: share of sample values that must pass
ID_MIN_RATE=0.95
# Concepts (phase 3): none | answers (answers/*.jsonl) | claude (Anthropic API, `uv sync --group llm`).
CONCEPT_MODEL=${CONCEPT_MODEL:-none}
# claude sends slot names and up to 30 sample values to a hosted API: allowed only with "yes" (open question)
CONCEPT_ALLOW_HOSTED=${CONCEPT_ALLOW_HOSTED:-no}
CONCEPT_CLAUDE_MODEL=${CONCEPT_CLAUDE_MODEL:-claude-opus-5-5}
CONCEPT_EFFORT=${CONCEPT_EFFORT:-medium}
# LLM answers accepted without review from this confidence (open question)
CONCEPT_MIN_CONFIDENCE=0.8
# Nearest registry entries shown to the model per slot
NEAREST=8
SHAPES="shapes.ttl vocab/ap-shapes.ttl vocab/mdr-shapes.ttl"
