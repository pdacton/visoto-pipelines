<https://opendata.swiss/set/data/bevoelkerung-test> dcat:distribution <https://opendata.swiss/set/distribution/bevoelkerung-test> .

<https://example.org/auto-profiling/structure/bevoelkerung> a prof:Structure ;
    dct:format <http://publications.europa.eu/resource/authority/file-type/CSV> ;
    dct:hasPart <https://example.org/auto-profiling/structure/bevoelkerung/main> ;
    dct:identifier "bevoelkerung" ;
    prov:wasGeneratedBy <https://example.org/auto-profiling/run/test> ;
    prof:declaredFormat <http://publications.europa.eu/resource/authority/file-type/CSV> ;
    prof:engine "tabular" ;
    prof:formatMatch true ;
    prof:profiledDistribution <https://opendata.swiss/set/distribution/bevoelkerung-test> ;
    prof:sourceURL "https://example.org/bevoelkerung.csv"^^xsd:anyURI ;
    prof:status prof:profiled .

<https://example.org/auto-profiling/structure/bevoelkerung/main> a sh:NodeShape,
        cube:Constraint ;
    csvw:dialect [ csvw:delimiter ";" ;
            csvw:encoding "utf-8" ;
            csvw:header true ;
            prof:dateFormat "%d.%m.%Y" ] ;
    sh:closed true ;
    sh:property [ sh:nodeKind sh:IRI ;
            sh:path cube:observedBy ],
        [ sh:in ( cube:Observation ) ;
            sh:nodeKind sh:IRI ;
            sh:path rdf:type ],
        <https://example.org/auto-profiling/structure/bevoelkerung/main/anteil_auslaender>,
        <https://example.org/auto-profiling/structure/bevoelkerung/main/bfs_nr>,
        <https://example.org/auto-profiling/structure/bevoelkerung/main/einwohner>,
        <https://example.org/auto-profiling/structure/bevoelkerung/main/flaeche_km2>,
        <https://example.org/auto-profiling/structure/bevoelkerung/main/gemeinde>,
        <https://example.org/auto-profiling/structure/bevoelkerung/main/hauptort>,
        <https://example.org/auto-profiling/structure/bevoelkerung/main/kanton>,
        <https://example.org/auto-profiling/structure/bevoelkerung/main/stichtag> ;
    prof:rowCount 60 .

<https://example.org/auto-profiling/structure/bevoelkerung/main/anteil_auslaender> a sh:PropertyShape,
        cube:MeasureDimension ;
    qudt:scaleType qudt:RatioScale ;
    schema:name "Anteil_Auslaender_%" ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:name "Anteil_Auslaender_%" ;
    sh:order 5 ;
    sh:path <https://example.org/auto-profiling/structure/bevoelkerung/main/col/anteil_auslaender> ;
    prof:observed [ prov:wasGeneratedBy <https://example.org/auto-profiling/run/test> ;
            prof:count 60 ;
            prof:distinct 50 ;
            prof:example "15.9",
                "29.8",
                "41.5" ;
            prof:max 46.9 ;
            prof:mean 30.4386 ;
            prof:min 15.1 ;
            prof:nullPercentage 5.0 ;
            prof:q25 22.425 ;
            prof:q50 31.7 ;
            prof:q75 36.925 ;
            prof:std 9.6 ] .

