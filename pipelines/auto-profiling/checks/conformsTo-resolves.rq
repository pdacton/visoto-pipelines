# Every dct:conformsTo target is a data structure in the output.
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ap:  <https://register.ld.admin.ch/mds/ontology/ap/>
SELECT ?problem WHERE {
  ?distribution dct:conformsTo ?target .
  FILTER NOT EXISTS { ?target a ap:DataStructure }
  BIND(CONCAT(STR(?distribution), " conforms to missing ", STR(?target)) AS ?problem)
}
