NAME=auto-profiling
GRAPH=urn:data:auto-profiling-githubpipeline
LABEL="Auto-detected structures of opendata.swiss distributions (visoto-pipelines)"
ODS_ENDPOINT=https://trifid.abn.ods.zazukoians.org/query
# Every minted IRI sits under this; changing it changes every IRI (see open-questions.md)
BASE_IRI=${BASE_IRI:-https://example.org/auto-profiling/}
# Rows (or features, PX cells) read per distribution
SAMPLE_ROWS=${SAMPLE_ROWS:-10000}
# Larger files are sampled from their footer or skipped as too-large
MAX_DOWNLOAD_MB=50
# Concurrent requests overall and per host; seconds per request
CONCURRENCY=8
PER_HOST=2
HTTP_TIMEOUT=30
# Seconds one request may take once it runs (httpx's timeout is per read)
FETCH_DEADLINE=300
# Seconds one equivalence group may take to profile; its worker is then killed (failed timeout)
PROFILE_TIMEOUT=300
# Dataset IRIs, one per line (relative to the pipeline folder); e.g. DATASETS=datasets-large.txt
# ${X:-default} keeps a value set in the environment (scripts/run.sh sources this file)
DATASETS=${DATASETS:-datasets.txt}
# WFS: layers sampled per service, features per layer
WFS_MAX_LAYERS=20
WFS_FEATURES=1000
