# SHACL shapes for the auto-profiling output itself (scripts/validate.sh).
# The aprof: namespace follows the default BASE_IRI; with another BASE_IRI, change it here too.
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix cube: <https://cube.link/> .
@prefix aprof: <https://example.org/auto-profiling/prof#> .
@prefix ap:   <https://example.org/auto-profiling/shapes#> .

ap:Structure a sh:NodeShape ;
    sh:targetClass aprof:Structure ;
    sh:property [ sh:path aprof:status ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( aprof:profiled aprof:skipped aprof:failed ) ] ,
                [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ] ,
                [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ] ,
                [ sh:path [ sh:inversePath dct:conformsTo ] ; sh:minCount 1 ] ;
    sh:xone (
        # profiled: at least one part
        [ sh:property [ sh:path aprof:status ; sh:hasValue aprof:profiled ] ,
                      [ sh:path dct:hasPart ; sh:minCount 1 ; sh:class sh:NodeShape ] ]
        # skipped or failed: a reason, no parts
        [ sh:property [ sh:path aprof:status ; sh:in ( aprof:skipped aprof:failed ) ] ,
                      [ sh:path aprof:statusReason ; sh:minCount 1 ; sh:datatype xsd:string ] ,
                      [ sh:path dct:hasPart ; sh:maxCount 0 ] ]
    ) .

ap:PropertyShape a sh:NodeShape ;
    sh:targetClass sh:PropertyShape ;
    sh:property [ sh:path sh:name ; sh:minCount 1 ] ,
                [ sh:path sh:path ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path sh:order ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path sh:minCount ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path sh:maxCount ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path aprof:observed ; sh:maxCount 1 ; sh:node ap:Observation ] .

ap:Observation a sh:NodeShape ;
    sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ] ,
                [ sh:path aprof:example ; sh:maxCount 3 ; sh:maxLength 200 ] ,
                [ sh:path aprof:nullPercentage ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
                  sh:minInclusive 0 ; sh:maxInclusive 100 ] .

# A cube:Constraint has key and measure dimensions.
ap:CubeConstraint a sh:NodeShape ;
    sh:targetClass cube:Constraint ;
    sh:property [ sh:path sh:property ; sh:qualifiedValueShape [ sh:class cube:KeyDimension ] ;
                  sh:qualifiedMinCount 1 ] ,
                [ sh:path sh:property ; sh:qualifiedValueShape [ sh:class cube:MeasureDimension ] ;
                  sh:qualifiedMinCount 1 ] .

ap:Distribution a sh:NodeShape ;
    sh:targetClass dcat:Distribution ;
    sh:property [ sh:path dct:conformsTo ; sh:minCount 1 ; sh:class aprof:Structure ] .
