# Pipeline-specific SHACL shapes for the auto-profiling output (scripts/validate.sh).
# The shapes of the ap: vocabulary itself are in vocab/ap-shapes.ttl; pipeline.env SHAPES lists both.
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix dcat:   <http://www.w3.org/ns/dcat#> .
@prefix cube:   <https://cube.link/> .
@prefix rml:    <http://w3id.org/rml/> .
@prefix ap:     <https://register.ld.admin.ch/mds/ontology/ap/> .
@prefix pipesh: <https://register.ld.admin.ch/mds/auto-profiling/shapes/> .

# Every distribution in the output conforms to a data structure (or its status stub).
pipesh:Distribution a sh:NodeShape ;
    sh:targetClass dcat:Distribution ;
    sh:property [ sh:path dct:conformsTo ; sh:minCount 1 ; sh:class ap:DataStructure ] .

# One observation per slot and run; every slot has a fingerprint.
pipesh:Slot a sh:NodeShape ;
    sh:targetClass ap:Slot ;
    sh:property [ sh:path ap:observed ; sh:maxCount 1 ] ,
                [ sh:path ap:fingerprint ; sh:minCount 1 ] .

# Every top-level container of a profiled structure is read by one logical source.
pipesh:TopContainer a sh:NodeShape ;
    sh:targetObjectsOf dct:hasPart ;
    sh:property [ sh:path [ sh:inversePath ap:container ] ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class rml:LogicalSource ] .

# A cube:Constraint has key and measure dimensions.
pipesh:CubeConstraint a sh:NodeShape ;
    sh:targetClass cube:Constraint ;
    sh:property [ sh:path sh:property ; sh:qualifiedValueShape [ sh:class cube:KeyDimension ] ;
                  sh:qualifiedMinCount 1 ] ,
                [ sh:path sh:property ; sh:qualifiedValueShape [ sh:class cube:MeasureDimension ] ;
                  sh:qualifiedMinCount 1 ] .
